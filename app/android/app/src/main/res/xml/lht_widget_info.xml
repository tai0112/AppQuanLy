<?xml version="1.0" encoding="utf-8"?>
<!-- Cập nhật 1 giờ/lần chỉ để tính lại "hôm nay" & số ngày yêu; dữ liệu mới được app đẩy ngay khi thay đổi. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="180dp"
    android:minResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/lht_widget"
    android:previewLayout="@layout/lht_widget"
    android:description="@string/lht_widget_desc"
    android:widgetCategory="home_screen" />
